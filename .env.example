# Content Studio configuration. Copy to .env and fill in what you need.
# Every provider is optional: with no key at all the keyless Mock strategist still produces (template) drafts.
# Each provider bills its own API usage to your own account.

# ---------- Database (required) ----------
# Any PostgreSQL 14+ database. Docker Compose builds this for you from POSTGRES_PASSWORD (see docker-compose.yml).
DATABASE_URL="postgresql://content_studio:change-me@localhost:5432/content_studio?schema=public"
# Used only by docker-compose.yml for the bundled postgres service.
POSTGRES_PASSWORD="change-me"

# ---------- Access (required in production) ----------
APP_PASSWORD=""            # shared login password, at least 16 characters. In `npm run dev` an empty value means no login.
AUTH_SECRET=""             # random string, 32+ characters, signs the session cookie (e.g. `openssl rand -base64 48`)
APP_URL=""                 # public address, e.g. https://studio.example.com. Used for OAuth redirects and hosted media URLs;
                           # derived from the request when empty.

# ---------- Text / script generation (pick per run in the UI) ----------
MOCK_LLM=""                # keyless mock strategist: on by default; set 0 to hide it
ANTHROPIC_API_KEY=""       # provider "anthropic"
ANTHROPIC_MODEL="claude-haiku-4-5"
ANTHROPIC_BASE_URL=""      # optional, default https://api.anthropic.com
OPENAI_API_KEY=""          # provider "openai" (also used for key visuals, see below)
OPENAI_MODEL="gpt-6-luna"
OPENAI_BASE_URL=""         # optional, default https://api.openai.com/v1
GEMINI_API_KEY=""          # provider "gemini"
GEMINI_MODEL="gemini-2.5-pro"
GEMINI_BASE_URL=""         # optional, default https://generativelanguage.googleapis.com/v1beta
LOCAL_LLM_BASE_URL=""      # provider "local": any OpenAI-compatible server, e.g. http://localhost:1234/v1 (LM Studio),
                           # http://localhost:11434/v1 (Ollama), vLLM, OpenRouter. From Docker use http://host.docker.internal:1234/v1
LOCAL_LLM_API_KEY=""       # optional (OpenRouter needs it, LM Studio ignores it)
LOCAL_LLM_MODEL=""         # e.g. openai/gpt-oss-20b
LOCAL_LLM_MAX_TOKENS=""    # optional output cap (default 16000; lower it for small context windows)

# ---------- Compliance review ----------
# Switched on per brand in the Brands tab. COMPLIANCE_REVIEW=off disables it for every brand (saves one model call per run).
COMPLIANCE_REVIEW=""

# ---------- Ideas tab (optional): any OpenAI-compatible server ----------
# Falls back to LOCAL_LLM_BASE_URL / LOCAL_LLM_API_KEY / LOCAL_LLM_MODEL when IDEAS_LLM_BASE_URL is empty.
IDEAS_LLM_BASE_URL=""
IDEAS_LLM_API_KEY=""
IDEAS_LLM_MODEL=""
IDEAS_LLM_MODELS=""        # optional extra models for the dropdown, comma separated
IDEAS_LLM_TIMEOUT_S=""     # optional, per model call, default 420
IDEAS_LLM_CF_CLIENT_ID=""  # optional Cloudflare Access service token, if the server sits behind Cloudflare Access
IDEAS_LLM_CF_CLIENT_SECRET=""
IDEAS_WEEKLY=""            # "on" writes a weekly idea bank every Monday from 03:00 (off by default)
IDEAS_WEEKLY_COUNT=""      # optional, ideas per weekly batch
IDEAS_WEEKLY_PLATFORMS_PER_BRAND=""  # optional, platforms per brand in the weekly bank
SCHEDULER_TIMEZONE=""      # time zone of the weekly jobs, default Europe/Berlin

# ---------- Voice-over (optional) ----------
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""     # default voice; can be changed per run
ELEVENLABS_MODEL="eleven_multilingual_v2"
ELEVENLABS_BASE_URL=""     # optional, default https://api.elevenlabs.io

# ---------- Video (optional): Higgsfield, Kling 3.0 Standard by default ----------
HIGGSFIELD_API_KEY=""      # key id
HIGGSFIELD_API_SECRET=""
HIGGSFIELD_BASE_URL=""     # optional, default https://api.higgsfield.ai
HIGGSFIELD_T2V_MODEL=""    # optional, default kling-video/v3.0/std/text-to-video
HIGGSFIELD_I2V_MODEL=""    # optional, default kling-video/v3.0/std/image-to-video
HIGGSFIELD_SOUND=""        # on | off (default off: the voice-over is generated separately)

# ---------- Key visuals (optional) ----------
# OpenAI images with OPENAI_API_KEY by default; IMAGE_PROVIDER=gemini uses GEMINI_API_KEY (needs a billing-enabled Google key).
IMAGE_PROVIDER=""          # openai | gemini
OPENAI_IMAGE_MODEL="gpt-image-2"
OPENAI_IMAGE_QUALITY="medium"  # low | medium | high | auto
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# ---------- Instagram / TikTok data sync (optional, see docs/CONNECTORS.md) ----------
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_EXTRA_SCOPES=""  # optional, e.g. instagram_business_content_publish
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_EXTRA_SCOPES=""     # optional, e.g. video.upload,video.publish
TOKEN_ENCRYPTION_KEY=""    # optional; platform tokens are encrypted with a key derived from this, or from AUTH_SECRET when empty

# ---------- Docker Compose ----------
PORT=""                    # host port for docker compose (default 3000)
CONTENT_STUDIO_IMAGE=""    # optional prebuilt image instead of building locally
